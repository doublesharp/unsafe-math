{
  "name": "@0xdoublesharp/unsafe-math",
  "version": "0.0.17",
  "description": "Unchecked arithmetic for Solidity 0.8.0+, with user-defined operators for 0.8.19+",
  "repository": "https://github.com/doublesharp/unsafe-math",
  "scripts": {
    "compile": "node scripts/forge.cjs build",
    "test": "node scripts/forge.cjs test --no-match-contract GasSavingsTest",
    "test:compat": "node scripts/check-compat.cjs",
    "test:gas": "node scripts/gas-report.cjs",
    "test:tools": "node --test scripts/tooling.test.cjs",
    "coverage": "node scripts/coverage.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "check:package": "node scripts/check-package.cjs",
    "format": "node scripts/forge.cjs fmt && prettier --write 'scripts/*.cjs'",
    "validate": "pnpm test:tools && pnpm check:docs && pnpm test:compat && pnpm test && pnpm coverage && pnpm test:gas && pnpm check:package"
  },
  "keywords": [
    "solidity",
    "unchecked",
    "unchecked-math",
    "unsafe-math",
    "math",
    "uint256",
    "int256",
    "U256",
    "I256"
  ],
  "author": "@0xDoubleSharp",
  "license": "MIT",
  "devDependencies": {
    "prettier": "2.8.7"
  },
  "files": [
    "contracts/UnsafeMath.sol",
    "contracts/PrimitiveUnsafeMath.sol",
    "contracts/types/",
    "docs/assets/",
    "README.md",
    "GAS_REPORT.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.21.0"
}
